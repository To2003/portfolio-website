# Sanity — proyecto creado en https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token con permiso "Editor" (Sanity → API → Tokens). Server-only, no exponer.
SANITY_API_TOKEN=

# Secret compartido con el webhook de Sanity (header Authorization: Bearer <valor>)
# que llama a /api/revalidate cuando publicás un cambio en el Studio.
SANITY_REVALIDATE_SECRET=

# Fine-grained PAT de solo lectura sobre repos públicos (opcional, sube el rate limit de la API de GitHub).
GITHUB_TOKEN=

# Protege /api/sync-github. Vercel lo manda solo en las invocaciones de su propio cron
# (Authorization: Bearer <CRON_SECRET>) si esta env var está configurada en el proyecto.
CRON_SECRET=
